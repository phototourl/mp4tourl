# -----------------------------------------------------------------------------
# Application BASE URL
# Production: https://mp4tourl.com
# Development: http://localhost:3000
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Database (MySQL) — DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME
# Bootstrap: run sql/mp4tourl.sql once on an empty database.
# -----------------------------------------------------------------------------
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="mp4tourl"

# -----------------------------------------------------------------------------
# Better Auth
# Generate a secret: openssl rand -base64 32
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=""

# -----------------------------------------------------------------------------
# Google OAuth
# https://www.better-auth.com/docs/authentication/google
# https://console.cloud.google.com/apis/credentials
# Callbacks: {BASE_URL}/api/auth/callback/google
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Email (Resend)
# https://resend.com
# Example: MP4TOURL <support@mp4tourl.com>
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# -----------------------------------------------------------------------------
# Storage — Cloudflare R2 (use these names in Dokploy Environment)
# Free video uploads: video/free/
# -----------------------------------------------------------------------------
R2_BUCKET=""
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BASE_URL=""

# -----------------------------------------------------------------------------
# Payment (Stripe)
# https://dashboard.stripe.com
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Pro plan - monthly subscription
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=""
# Pro plan - yearly subscription
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=""
# Lifetime plan - one-time payment
NEXT_PUBLIC_STRIPE_PRICE_LIFETIME=""

# -----------------------------------------------------------------------------
# Configurations
# -----------------------------------------------------------------------------
DISABLE_IMAGE_OPTIMIZATION=false
NEXT_PUBLIC_DEMO_WEBSITE=false

# -----------------------------------------------------------------------------
# Analytics
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
NEXT_PUBLIC_UMAMI_SCRIPT="https://cloud.umami.is/script.js"
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_PLAUSIBLE_SCRIPT="https://plausible.io/js/script.js"
NEXT_PUBLIC_AHREFS_WEBSITE_ID=""
NEXT_PUBLIC_SELINE_TOKEN=""
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=""
NEXT_PUBLIC_DATAFAST_DOMAIN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""
NEXT_PUBLIC_CLARITY_PROJECT_ID=""

# -----------------------------------------------------------------------------
# Notification
# -----------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=""
FEISHU_WEBHOOK_URL=""

# -----------------------------------------------------------------------------
# Affiliate (optional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AFFILIATE_AFFONSO_ID=""
NEXT_PUBLIC_AFFILIATE_PROMOTEKIT_ID=""

# -----------------------------------------------------------------------------
# Captcha (Cloudflare Turnstile)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# -----------------------------------------------------------------------------
# Cron Jobs
# -----------------------------------------------------------------------------
CRON_JOBS_USERNAME=""
CRON_JOBS_PASSWORD=""
